# Copy to .env (never commit .env). Read by inference/service.py.

# Embed new items via DeepInfra. Leave unset to embed locally with PAIR.
DEEPINFRA_API_KEY=

# Path to a PAIR checkout, only needed if PAIR is not pip-installed.
# PAIR_REPO=/path/to/PAIR

# Folder for the SQLite databases (default: ./data).
# PAIR_DATA_DIR=
